# ==============================================================================
# OneStop Environment Configuration Template
# Copy this file to '.env' and fill in your actual values.
# DO NOT commit '.env' containing real secrets to version control.
# ==============================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/onestopdb
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Groq Cloud API (Used for AI Placement Prep & Scholarship Matching)
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google OAuth2 Credentials (Used for Google Sign-In)
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT Configuration (Optional override, min 32 characters)
JWT_SECRET=replace-this-with-a-long-random-secret-value-at-least-32-characters
